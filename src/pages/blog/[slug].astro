---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const articles = await getCollection("blog", ({ data }) => !data.draft);

    return articles.map((article) => ({
        params: { slug: article.slug },
        props: { article },
    }));
}

const { article } = Astro.props;
const { Content } = await article.render();

const { date, updatedDate } = article.data;
const toYMD = (d: Date) => d.toISOString().slice(0, 10);
const showUpdated = updatedDate && toYMD(updatedDate) !== toYMD(date);
---

<BaseLayout title={article.data.title} description={article.data.summary}>
    <article class="article-content">
        <header class="article-header">
            <h1>{article.data.title}</h1>

            <p class="article-meta">
                {date.toDateString()}
                {showUpdated && <span class="article-updated"> · Updated {updatedDate!.toDateString()}</span>}
            </p>
        </header>

        <Content />
    </article>
</BaseLayout>

<script>
    // Language labels on code blocks
    document.querySelectorAll<HTMLElement>(".article-content pre > code[class]").forEach((code) => {
        const match = code.className.match(/language-(\w+)/);
        if (match) {
            const lang = match[1] === "csharp" ? "C#" : match[1];
            const pre = code.closest("pre") as HTMLElement;
            if (pre) pre.dataset.language = lang;
        }
    });

    // Grid images sit directly in the grid in some articles: wrap them in a figure so they share the same styling and click behavior
    document.querySelectorAll<HTMLImageElement>(".image-grid > img").forEach((img) => {
        const fig = document.createElement("figure");
        img.replaceWith(fig);
        fig.appendChild(img);
    });

    // Grid figures open the full image in a new tab (captions are hover-only, always visible on touch screens)
    document.querySelectorAll<HTMLElement>(".image-grid figure").forEach((fig) => {
        const img = fig.querySelector("img");
        if (!img) return;
        fig.classList.add("zoomable");
        fig.setAttribute("role", "link");
        fig.setAttribute("tabindex", "0");
        fig.setAttribute("aria-label", `Open image in a new tab: ${img.alt}`);
        const open = () => window.open(img.currentSrc || img.src, "_blank", "noopener");
        fig.addEventListener("click", open);
        fig.addEventListener("keydown", (event) => {
            if (event.key === "Enter") open();
        });
    });

    // Standalone article images link to the full image in a new tab
    document.querySelectorAll<HTMLImageElement>(".article-content img").forEach((img) => {
        if (img.closest(".image-grid, a")) return;
        const link = document.createElement("a");
        link.href = img.currentSrc || img.src;
        link.target = "_blank";
        link.rel = "noopener";
        link.className = "zoomable";
        link.setAttribute("aria-label", `Open image in a new tab: ${img.alt}`);
        img.replaceWith(link);
        link.appendChild(img);
    });

    // Collapsible code blocks
    const THRESHOLD = 320;
    document.querySelectorAll<HTMLElement>(".article-content pre").forEach((pre) => {
        if (pre.scrollHeight > THRESHOLD + 20) {
            pre.classList.add("collapsed");
            const lang = pre.dataset.language ?? "code";
            const btn = document.createElement("button");
            btn.textContent = "Show more";
            btn.className = "code-expand-btn";
            btn.setAttribute("aria-expanded", "false");
            btn.setAttribute("aria-label", `Show more of this ${lang} block`);
            btn.addEventListener("click", () => {
                const collapsed = pre.classList.toggle("collapsed");
                btn.textContent = collapsed ? "Show more" : "Show less";
                btn.setAttribute("aria-expanded", String(!collapsed));
                btn.setAttribute("aria-label", collapsed ? `Show more of this ${lang} block` : `Show less of this ${lang} block`);
            });
            pre.insertAdjacentElement("afterend", btn);
        }
    });
</script>
